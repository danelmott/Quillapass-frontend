# Copia este archivo a `.env.local` (ignorado por git) y completa los valores.
# Reinicia `npx expo start` después de cambiarlos.
#
# Solo variables EXPO_PUBLIC_*: viajan dentro de la app, cualquiera puede leerlas.
# NUNCA pongas aquí la llave *secret* / service_role ni la contraseña de la base de datos.

# Project URL (Supabase > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Llave publishable (Supabase > Project Settings > API Keys)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<tu-llave-publishable>

# true = usar los mocks de G0 (sin backend) · false = API real
EXPO_PUBLIC_USE_MOCKS=true

# Login (T3): si NO pones URL/llave de Supabase, la app usa modo demo.
# Cualquier correo válido + código 123456. Con Supabase, signInWithOtp / verifyOtp.
